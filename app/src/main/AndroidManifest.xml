<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        "All files access". Android's own documentation states this permission
        covers "the root directory of both the USB on-the-go (OTG) drive and the
        SD card" — which the SAF tree grant cannot reach, because Android 11+
        refuses to let the user pick a removable volume's root. The MANAGED_PATH
        storage track is built on it, and without this declaration the permission
        can never be granted, so that track is dead on API 30+.

        Google Play requires a declaration form for this permission and restricts
        it to file-management-class apps; sideloaded and enterprise-distributed
        builds are not subject to that review. ScopedStorage is lint's advisory
        warning about exactly that policy, acknowledged here rather than left to
        fail the lint gate.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".OtgDriveBridgeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OtgDriveBridge"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OtgDriveBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WebDavService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
